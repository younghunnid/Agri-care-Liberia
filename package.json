{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ENABLE_DEMO_SEED=1 tsx server.ts",
    "start": "node server.js",
    "build": "vite build && node scripts/build-server.mjs",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js backup-db.js restore-db.js bootstrap-admin.js recover-account.js",
    "lint": "tsc --noEmit",
    "db:migrate:down": "tsx scripts/migrate-down.ts",
    "auth:recover-account": "tsx scripts/recover-account.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "test:api": "tsx tests/api.test.ts",
    "dev:https": "node scripts/dev-https-proxy.mjs",
    "test:harness": "tsx tests/contract/normalize.test.ts",
    "test:contract": "tsx tests/contract/run.ts",
    "test:contract:update": "tsx tests/contract/run.ts --update",
    "test:offline": "tsx tests/offlineAdvisor.test.ts && tsx tests/dataCache.test.ts && tsx tests/offlineInventory.test.ts",
    "test:h1": "tsx --test tests/h1.test.ts",
    "test:h2": "tsx --test tests/h2.test.ts",
    "test:sms": "tsx --test tests/sms-auth.test.ts",
    "test:ministry": "tsx --test tests/ministry.test.ts",
    "test:m3": "tsx --test tests/m3/run.ts",
    "test:m3:unit": "php backend-php/tests/m3_unit.php",
    "test:deploy": "tsx --test tests/deploy.test.ts",
    "test:phase0": "tsx --test tests/phase0.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

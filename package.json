{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ENABLE_DEMO_SEED=1 tsx server.ts",
    "start": "node server.js",
    "build": "vite build && node scripts/build-server.mjs",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js backup-db.js restore-db.js bootstrap-admin.js recover-account.js real-mode-prep.js",
    "lint": "tsc --noEmit",
    "db:migrate:down": "tsx scripts/migrate-down.ts",
    "auth:recover-account": "tsx scripts/recover-account.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "test:api": "tsx tests/api.test.ts",
    "dev:https": "node scripts/dev-https-proxy.mjs",
    "test:harness": "tsx tests/contract/normalize.test.ts",
    "test:contract": "tsx tests/contract/run.ts",
    "test:contract:update": "tsx tests/contract/run.ts --update",
    "test:offline": "tsx tests/offlineAdvisor.test.ts && tsx tests/dataCache.test.ts && tsx tests/offlineInventory.test.ts",
    "test:h1": "tsx --test tests/h1.test.ts",
    "test:h2": "tsx --test tests/h2.test.ts",
    "test:sms": "tsx --test tests/sms-auth.test.ts",
    "test:ministry": "tsx --test tests/ministry.test.ts",
    "test:m3": "tsx --test tests/m3/run.ts",
    "test:m3:unit": "php backend-php/tests/m3_unit.php",
    "test:deploy": "tsx --test tests/deploy.test.ts",
    "test:phase0": "tsx --test tests/phase0.test.ts",
    "test:phase0b": "tsx --test tests/phase0b.test.ts",
    "test:triage": "tsx --test tests/triage.test.ts",
    "test:harvest": "tsx --test tests/harvest.test.ts tests/harvest-client.test.ts",
    "test:hardening": "tsx --test tests/hardening.test.ts",
    "test:phase2a": "tsx --test tests/phase2a.test.ts",
    "test:phase2b": "tsx --test tests/phase2b.test.ts",
    "test:ussd-marketplace": "tsx --test tests/ussd-marketplace.test.ts tests/ussd-null-code.test.ts tests/ussd-real-market.test.ts",
    "test:ussd-enrollment": "tsx --test tests/ussd-enrollment.test.ts",
    "test:ussd-enrollment-browser": "tsx tests/ussd-enrollment-browser.ts",
    "test:voice-mobile": "tsx tests/voice-mobile-emulation.ts",
    "test:ussd-only": "tsx tests/ussd-only-browser.ts",
    "test:weather-rice-browser": "tsx tests/weather-rice-browser.ts",
    "test:ussd-recovery": "tsx tests/ussd-recovery-browser.ts",
    "test:sw-update": "tsx --test tests/sw-update.test.ts",
    "test:weather": "tsx --test tests/weather.test.ts tests/weather-ussd.test.ts tests/rice-advice.test.ts",
    "test:ussd-update-bridge": "tsx --test tests/ussd-update-bridge.test.ts",
    "test:public-deployment": "tsx --test tests/public-deployment.test.ts",
    "test:sw-update-sim": "tsx scripts/sw-update-simulation.mts",
    "test:real-mode-browser": "tsx tests/real-mode-browser.ts",
    "test:offline-qa": "node --import tsx --test tests/offline-qa.test.ts",
    "test:browser-qa": "node --import tsx tests/browser-qa.ts",
    "test:ministry-workspace": "node --import ./tests/assets-loader/register.mjs --import tsx --test tests/ministry-workspace.test.tsx",
    "test:role-dashboards": "node --import ./tests/assets-loader/register.mjs --import tsx --test tests/role-dashboards.test.tsx",
    "test:home": "node --import ./tests/assets-loader/register.mjs --import tsx --test tests/home-redesign.test.tsx",
    "test:password-policy": "tsx --test tests/password-policy.test.ts",
    "test:brand": "node --import ./tests/assets-loader/register.mjs --import tsx --test tests/brand.test.tsx",
    "test:password-auth": "tsx --test tests/password-auth.test.ts",
    "test:auth-ussd": "tsx --test tests/auth-ussd-integration.test.ts",
    "test:recovery": "tsx --test tests/recovery.test.ts",
    "test:real-mode": "tsx --test tests/real-mode.test.ts",
    "test:real-mode-config": "tsx --test tests/real-mode-config.test.ts",
    "test:backup-restore": "tsx --test tests/backup-restore.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "6.2.5",
    "jsqr": "1.4.0",
    "playwright": "1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

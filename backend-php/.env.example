# Copy to backend-php/.env (outside the web root in production, chmod 600). NEVER commit real values.
# Every value below must be set explicitly; there are no silent fallbacks. Leave nothing as a placeholder in production.

# production | staging | development | test   (unset or unknown is treated as production and must then pass full validation)
APP_ENV=
# https origin of the site, e.g. https://example.org (required in production/staging)
APP_URL=
# Random, >= 32 characters in production (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Random, >= 32 characters; must equal the value Node actually used to hash owner/requester keys (docs/PHP_MYSQL_MIGRATION_PLAN.md section 8.3)
OWNER_KEY_HMAC_SECRET=
DB_HOST=
DB_PORT=3306
DB_NAME=
# Least-privilege application user (not root)
DB_USER=
DB_PASS=
# Optional
# CORS_ALLOWED_ORIGINS=https://staging.example.org      (comma separated, https only, no wildcard)
# COOKIE_MODE=first_party                               (first_party | cross_site; cross_site is refused in production/staging)
# TRUST_PROXY=0                                         (default: X-Forwarded-* are IGNORED. 1 requires TRUSTED_PROXY_CIDRS)
# TRUSTED_PROXY_CIDRS=                                  (comma separated proxy IPs/CIDRs allowed to set X-Forwarded-*; never assumed, take them from the host.
#                                                        Ranges wider than /8 (IPv4) or /32 (IPv6) are refused. Forwarded headers from any other peer are ignored)
# MAX_BODY_BYTES=4194304
# HSTS_MAX_AGE=0                                        (set e.g. 31536000 only after HTTPS is confirmed)
# LOG_DIR=                                              (default backend-php/storage/logs; must be private)
# GEMINI_API_KEY=
# Development/test only (refused in production/staging): APP_DEBUG, TEST_FIXTURE_TOKEN, ENABLE_TEST_FIXTURES, ENABLE_DEMO_SEED, DEMO_*_PASSWORD

# --- Authentication-related settings (validated now, used from M4; production/staging require the ones marked REQUIRED) ---
# IP_HASH_SECRET=                                       (REQUIRED in production; random >= 32 chars; must differ from SESSION_SECRET / OWNER_KEY_HMAC_SECRET)
# SESSION_IDLE_MINUTES=720                              (5-1440)      SESSION_ABSOLUTE_HOURS=168       (1-720)
# SESSION_IDLE_MINUTES_ADMIN=30                         (5-120)       SESSION_ABSOLUTE_HOURS_ADMIN=8   (1-24; admin windows may not exceed ordinary ones)
# PASSWORD_HASH_SCHEME=                                 (REQUIRED in production: legacy | argon2id | bcrypt)
# PASSWORD_REHASH_ENABLED=                              (REQUIRED in production: 0|1; 1 is refused together with legacy)
# PASSWORD_ARGON2_MEMORY_KIB=19456  PASSWORD_ARGON2_TIME=2  PASSWORD_ARGON2_THREADS=1  PASSWORD_BCRYPT_COST=12
# MAIL_TRANSPORT=null                                   (null | smtp in production; log/capture are test-only and refused. NO mail is sent by this milestone)
# MAIL_HOST= MAIL_PORT= MAIL_ENCRYPTION=tls|starttls MAIL_USERNAME= MAIL_PASSWORD= MAIL_FROM_ADDRESS= MAIL_FROM_NAME=   (smtp only; peer verification cannot be disabled)
# --- Health endpoint ---
# HEALTH_CACHE_TTL_SECONDS=15   HEALTH_FAIL_CACHE_TTL_SECONDS=3   (public /health is cached; 0 disables caching outside production only)
# HEALTH_DEEP_TOKEN=                                    (>= 32 chars; enables GET /api/v1/health?deep=1 with header X-Health-Token; unset = the deep check does not exist)
# HEALTH_DEEP_RATE_PER_MINUTE=10
# CACHE_DIR=                                            (default backend-php/storage/cache; must be private)

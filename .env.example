# Agri-Advisory Liberia: environment template for the Node.js server. NEVER commit a real .env. On Hostinger set these in hPanel (Node.js app > Environment variables).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- required in production and in the protected demo environment (the server refuses to start without them)
NODE_ENV="production"
# At least 32 random characters. Keep it fixed: changing it signs every user out.
SESSION_SECRET=""
# ABSOLUTE path OUTSIDE the application folder (each deployment replaces that folder), writable and persistent, e.g. /home/<user>/agri-data/agri.db
DB_PATH=""
# At least 32 random characters, different from SESSION_SECRET (hashes verification codes).
OTP_HMAC_SECRET=""

# ---- proxy and cookies
# Number of reverse proxies in front of Node (default 1). Measure on staging with the diagnostics, then set explicitly. 0 = trust no forwarding headers.
TRUST_PROXY="1"
# first_party (default in production/demo) = SameSite=Lax; Secure. cross_site is for embedded previews in development only and is refused in production.
# COOKIE_MODE="first_party"

# ---- SQLite
# wal (default) or delete (fallback if staging shows WAL is unreliable on the host's file system)
# SQLITE_JOURNAL_MODE="wal"

# ---- protected hackathon demonstration environment (synthetic accounts only; simulated SMS; never real farmers)
# APP_ENV="demo"
# SMS_PROVIDER="simulated"
# DEMO_INLINE_INBOX="1"
# DEMO_ENV_ACK="synthetic-accounts-only"
# ENABLE_DEMO_SEED="1"          # creates the two documented synthetic demo accounts; refused in production
# SIMULATED_INBOX="1"           # optional presenter inbox (needs DEMO_OPERATOR_TOKEN, a separate 32+ character secret)
# DEMO_OPERATOR_TOKEN=""

# ---- server
# PORT and HOST are normally provided by the host. Defaults: 3000 and 0.0.0.0.
# PORT="3000"
APP_URL=""

# ---- AI (leave empty to keep live AI off; the on-device advisor works without it)
GEMINI_API_KEY=""
AI_ANON_DAILY_LIMIT="5"
AI_AUTH_HOURLY_LIMIT="30"
AI_TIMEOUT_MS="20000"

# ---- staging diagnostics (set ONLY during the staging tests, then remove): enables /api/v1/__staging/*  (32+ random characters, separate secret)
# STAGING_DIAG_TOKEN=""

# ---- development only
# ENABLE_DEMO_SEED="1"   (npm run dev sets this for you)

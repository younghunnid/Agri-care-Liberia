# Agricare Liberia: environment template for the Node.js server. NEVER commit a real .env. On Hostinger set these in hPanel (Node.js app > Environment variables).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- required in production and in the protected demo environment (the server refuses to start without them)
NODE_ENV="production"
# At least 32 random characters. Keep it fixed: changing it signs every user out.
SESSION_SECRET=""
# ABSOLUTE path OUTSIDE the application folder (each deployment replaces that folder), writable and persistent, e.g. /home/<user>/agri-data/agri.db
DB_PATH=""
# At least 32 random characters, different from SESSION_SECRET (hashes verification codes).
OTP_HMAC_SECRET=""

# ---- proxy and cookies
# Number of reverse proxies in front of Node (default 1). Measure on staging with the diagnostics, then set explicitly. 0 = trust no forwarding headers.
TRUST_PROXY="1"
# first_party (default in production/demo) = SameSite=Lax; Secure. cross_site is for embedded previews in development only and is refused in production.
# COOKIE_MODE="first_party"

# ---- SQLite
# wal (default) or delete (fallback if staging shows WAL is unreliable on the host's file system)
# SQLITE_JOURNAL_MODE="wal"

# ---- sign-in method
# Default (leave unset): phone number + password, NO SMS codes. Phone numbers are stored UNVERIFIED, a number is never taken from the account that registered it,
# and password recovery needs verified assistance from the team (scripts/recover-account.ts for the number). Needs no SMS provider.
# AUTH_REQUIRE_SMS="1"   # only once a real SMS provider exists: new-device sign-in, recovery and phone proof use SMS codes (refused if SMS_PROVIDER is none)

# ---- protected hackathon demonstration environment (synthetic accounts only; simulated SMS; never real farmers)
# APP_ENV="demo"
# SMS_PROVIDER="simulated"
# DEMO_INLINE_INBOX="1"
# DEMO_ENV_ACK="synthetic-accounts-only"
# ENABLE_DEMO_MARKET_DATA="1"   # ADDS any missing SYNTHETIC harvest listings and crop checks at start (never deletes or changes existing ones; demo/development only; refused in production)
# INSIGHTS_MIN_CHANGE="3"       # Ministry numbers change only after this many records were added or removed (default 3; below 3 is refused in production/demo)
# ENABLE_DEMO_SEED="1"          # creates the two synthetic demo accounts; refused in production. Needs the two private passwords below.
# DEMO_FARMER_PASSWORD=""       # 12+ characters, private, never the passwords published in the project documents
# DEMO_EXPERT_PASSWORD=""       # 12+ characters, private, different from the farmer one
# SIMULATED_INBOX="1"           # optional presenter inbox (needs DEMO_OPERATOR_TOKEN, a separate 32+ character secret)
# DEMO_OPERATOR_TOKEN=""

# ---- abuse limits (defaults are for a public demonstration)
# LOGIN_IP_FAIL_MAX="30"            # failed sign-ins per address per 15 minutes
# PUBLIC_WRITE_LIMIT_SCALE="1"      # multiplier for anonymous expert-request / listing / inquiry limits
# PASSWORD_HASH_CONCURRENCY="3"     # simultaneous password hashes; a flood is answered 503 "busy"
# ANON_MEDIA_BUDGET_MB="150"        # total photo/voice data visitors without an account may store in the database (507 when full)
# START_SERVER="1"                  # only if the host starts the app through its own loader and the app does not listen

# ---- server
# PORT and HOST are normally provided by the host. Defaults: 3000 and 0.0.0.0.
# PORT="3000"
APP_URL=""

# ---- AI (leave empty to keep live AI off; the on-device advisor works without it)
GEMINI_API_KEY=""
AI_ANON_DAILY_LIMIT="5"
AI_AUTH_HOURLY_LIMIT="30"
AI_TIMEOUT_MS="20000"

# ---- staging diagnostics (set ONLY during the staging tests, then remove): enables /api/v1/__staging/*  (32+ random characters, separate secret)
# STAGING_DIAG_TOKEN=""

# ---- development only
# ENABLE_DEMO_SEED="1"   (npm run dev sets this for you)

# ---- public browser presentation settings (embedded in the Vite build; NEVER place secrets here)
# Public HTTPS origin hosting THIS app, or its /ussd-demo URL. No localhost, IP, query, fragment or credentials.
VITE_PUBLIC_DEMO_URL=""
# Enables confirmed browser marketplace actions ONLY when /api/v1/environment also reports the existing protected synthetic-only demo mode.
# Use a separate demo database/origin/profile. This does not configure or seed the server. Default remains read-only/practice.
VITE_USSD_MARKETPLACE_ENABLED="false"
